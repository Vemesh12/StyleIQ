# PostgreSQL connection string used by Prisma.
# Example: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=

# Secret used to sign admin/user session JWTs. Required — the app will refuse
# to start without it. Generate one with: openssl rand -base64 32
JWT_SECRET=

# Public base URL of the deployed app (used for metadata/sitemap generation).
NEXT_APP_URL=http://localhost:3000

# Admin account created by `npx prisma db seed` (and by
# `npm run admin:set-password`). If ADMIN_PASSWORD is empty a random password
# is generated and printed once. Minimum 12 characters.
ADMIN_EMAIL=admin@styleiq.com
ADMIN_PASSWORD=

# Number of reverse proxies in front of the app that append to
# X-Forwarded-For (Vercel / a single nginx or load balancer = 1). Used to find
# the real client IP for rate limiting. Without any proxy, clients can forge
# their IP, so production should always run behind one.
TRUSTED_PROXY_HOPS=1

# Set to 1 to log every SQL query Prisma runs (very noisy; debugging only).
# PRISMA_LOG_QUERIES=1

# Optional: Upstash Redis REST credentials. When set, rate limits are shared by
# every server instance (needed on serverless / multi-instance hosting).
# Without them, limits are kept in each process's memory. Set both or neither.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
