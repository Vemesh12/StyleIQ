// Prisma schema for StyleIQ - Men's Fashion Knowledge Platform
// Database: PostgreSQL. Change it with `npx prisma migrate dev --name <change>`;
// migrations live in prisma/migrations. Value ranges and allowed vocabularies
// below are also enforced by CHECK constraints in the migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// REFERENCE / LOOKUP TABLES
// ============================================================

model GarmentType {
  id       String    @id @default(cuid())
  name     String    @unique // 'Shirt', 'Trouser', 'Shoe', etc.
  slug     String    @unique
  garments Garment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("garment_types")
}

model Color {
  id        String  @id @default(cuid())
  name      String  @unique // 'Navy Blue'
  hex       String // '#1B2A4A'
  slug      String  @unique
  family    String // 'Blue', 'Red', 'Neutral'
  isNeutral Boolean @default(false)

  garmentColors       GarmentColor[]
  colorCompatibilityA ColorCompatibilityRule[] @relation("ColorA")
  colorCompatibilityB ColorCompatibilityRule[] @relation("ColorB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("colors")
}

model Fit {
  id   String @id @default(cuid())
  name String @unique // 'Slim Fit'
  slug String @unique

  garmentFits GarmentFit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fits")
}

model Material {
  id            String @id @default(cuid())
  name          String @unique // 'Egyptian Cotton'
  slug          String @unique
  breathability Int    @default(3) // 1-5
  formality     Int    @default(3) // 1-5

  garmentMaterials GarmentMaterial[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("materials")
}

model Pattern {
  id       String  @id @default(cuid())
  name     String  @unique // 'Solid', 'Striped'
  slug     String  @unique
  isFormal Boolean @default(false)

  garmentPatterns GarmentPattern[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("patterns")
}

model Occasion {
  id             String @id @default(cuid())
  name           String @unique // 'Business Formal'
  slug           String @unique
  formalityLevel Int // 1-5
  description    String @default("")

  garmentOccasions GarmentOccasion[]
  ruleOccasions    RuleOccasion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("occasions")
}

model Season {
  id   String @id @default(cuid())
  name String @unique // 'Summer'
  slug String @unique

  garmentSeasons GarmentSeason[]
  ruleSeasons    RuleSeason[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("seasons")
}

model BodyType {
  id          String @id @default(cuid())
  name        String @unique // 'Athletic'
  slug        String @unique
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("body_types")
}

model SkinTone {
  id          String @id @default(cuid())
  name        String @unique // 'Wheatish'
  slug        String @unique
  description String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("skin_tones")
}

// ============================================================
// GARMENTS MASTER TABLE
// ============================================================

model Garment {
  id             String      @id @default(cuid())
  name           String // 'Oxford Button-Down Shirt'
  slug           String      @unique
  garmentType    GarmentType @relation(fields: [garmentTypeId], references: [id])
  garmentTypeId  String
  description    String      @default("")
  formalityLevel Int         @default(3) // 1=Ultra Casual, 5=Black Tie
  imageUrl       String      @default("")

  // Multi-dimensional attributes (junction tables)
  colors    GarmentColor[]
  fits      GarmentFit[]
  materials GarmentMaterial[]
  patterns  GarmentPattern[]
  occasions GarmentOccasion[]
  seasons   GarmentSeason[]

  // Compatibility rules
  compatibilityAsA CompatibilityRule[] @relation("GarmentA")
  compatibilityAsB CompatibilityRule[] @relation("GarmentB")

  digitalWardrobes DigitalWardrobe[]
  savedOutfitItems SavedOutfitItem[]

  // NULL = shared catalog item; otherwise a user's own item ("my navy
  // chinos"), visible only to that user and never exported to prisma/data.
  owner   User?   @relation("OwnedGarments", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([garmentTypeId])
  @@index([ownerId])
  @@map("garments")
}

// ============================================================
// GARMENT JUNCTION TABLES (many-to-many with properties)
// ============================================================

model GarmentColor {
  id        String  @id @default(cuid())
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  garmentId String
  color     Color   @relation(fields: [colorId], references: [id], onDelete: Cascade)
  colorId   String
  isPrimary Boolean @default(false)

  @@unique([garmentId, colorId])
  @@index([colorId])
  @@map("garment_colors")
}

model GarmentFit {
  id        String  @id @default(cuid())
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  garmentId String
  fit       Fit     @relation(fields: [fitId], references: [id], onDelete: Cascade)
  fitId     String
  isPrimary Boolean @default(false)

  @@unique([garmentId, fitId])
  @@map("garment_fits")
}

model GarmentMaterial {
  id         String   @id @default(cuid())
  garment    Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  garmentId  String
  material   Material @relation(fields: [materialId], references: [id], onDelete: Cascade)
  materialId String
  percentage Int      @default(100)

  @@unique([garmentId, materialId])
  @@map("garment_materials")
}

model GarmentPattern {
  id        String  @id @default(cuid())
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  garmentId String
  pattern   Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)
  patternId String
  isPrimary Boolean @default(false)

  @@unique([garmentId, patternId])
  @@map("garment_patterns")
}

model GarmentOccasion {
  id          String   @id @default(cuid())
  garment     Garment  @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  garmentId   String
  occasion    Occasion @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  occasionId  String
  suitability Int      @default(3) // 1-5

  @@unique([garmentId, occasionId])
  @@index([occasionId])
  @@map("garment_occasions")
}

model GarmentSeason {
  id          String  @id @default(cuid())
  garment     Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  garmentId   String
  season      Season  @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId    String
  suitability Int     @default(3) // 1-5

  @@unique([garmentId, seasonId])
  @@index([seasonId])
  @@map("garment_seasons")
}

// ============================================================
// COMPATIBILITY RULES — The Core of the System
// ============================================================

model CompatibilityRule {
  id                String  @id @default(cuid())
  garmentA          Garment @relation("GarmentA", fields: [garmentAId], references: [id], onDelete: Cascade)
  garmentAId        String
  garmentB          Garment @relation("GarmentB", fields: [garmentBId], references: [id], onDelete: Cascade)
  garmentBId        String
  rating            Float // 1.0 to 5.0
  reason            String  @default("")
  // Derived from rating (see compatibilityTypeForRating): 'excellent' | 'good' | 'acceptable' | 'avoid'
  compatibilityType String  @default("good")

  occasions RuleOccasion[]
  seasons   RuleSeason[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([garmentAId, garmentBId])
  @@index([garmentBId])
  @@map("compatibility_rules")
}

model RuleOccasion {
  id         String            @id @default(cuid())
  rule       CompatibilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId     String
  occasion   Occasion          @relation(fields: [occasionId], references: [id], onDelete: Cascade)
  occasionId String

  @@unique([ruleId, occasionId])
  @@map("rule_occasions")
}

model RuleSeason {
  id       String            @id @default(cuid())
  rule     CompatibilityRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  ruleId   String
  season   Season            @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  seasonId String

  @@unique([ruleId, seasonId])
  @@map("rule_seasons")
}

// ============================================================
// COLOR COMPATIBILITY RULES
// ============================================================

model ColorCompatibilityRule {
  id       String @id @default(cuid())
  colorA   Color  @relation("ColorA", fields: [colorAId], references: [id], onDelete: Cascade)
  colorAId String
  colorB   Color  @relation("ColorB", fields: [colorBId], references: [id], onDelete: Cascade)
  colorBId String
  harmony  String // Display label, e.g. 'Neutral Anchor', 'Perfect Contrast', 'Clash'
  score    Float // 0-10; below 6 counts as a clash
  ruleType String @default("curated") // Free-form tag describing the pairing, e.g. 'autumn-formal'
  reason   String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([colorAId, colorBId])
  @@index([colorBId])
  @@map("color_compatibility_rules")
}

// ============================================================
// CONTENT TABLES
// ============================================================

model Guide {
  id        String  @id @default(cuid())
  title     String // 'The Complete Business Casual Guide'
  slug      String  @unique
  category  String  @default("style") // 'style' | 'occasion' | 'body' | 'season' | 'accessory'
  content   String  @default("") // Markdown (rendered by components/markdown-content.tsx)
  excerpt   String  @default("")
  seoTitle  String  @default("")
  seoDesc   String  @default("")
  published Boolean @default(false)
  imageUrl  String  @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("guides")
}

model StyleRule {
  id          String @id @default(cuid())
  title       String // 'Never mix brown belt with black shoes'
  ruleType    String @default("dos") // 'dos' | 'donts' | 'pro-tip'
  explanation String @default("")
  category    String @default("general") // 'general' | 'color' | 'fit' | 'occasion' | 'accessory'

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("style_rules")
}

// ============================================================
// ADMIN TABLE
// ============================================================

model AdminUser {
  id       String @id @default(cuid())
  email    String @unique
  password String // hashed
  name     String @default("")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

// ============================================================
// PERSONALIZATION ENGINE RULES
// Generated by the seed from prisma/data/personalization.json: one row per
// combination of the six inputs. Each advice column depends on one input
// (colors/metal on underTone, fit/patterns/fabric on bodyProportion, shoes on
// torsoLength).
// ============================================================

model PersonalizationRule {
  id                                  String @id @default(cuid())
  hairColor                           String
  eyeColor                            String
  skinTone                            String
  underTone                           String
  torsoLength                         String
  bodyProportion                      String
  recommendedClothingColors           String
  avoidClothingColors                 String
  recommendedFittingStyle             String
  recommendedMaterials                String
  recommendedPatterns                 String
  recommendedJewelryMetal             String
  recommendedShoes                    String
  recommendedClothingColorWheelRegion String
  avoidClothingColorWheelRegion       String
  fabricNature                        String
  dontExaggerate                      String
  doExaggerate                        String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([skinTone, underTone, torsoLength, bodyProportion])
  @@map("personalization_rules")
}

// ============================================================
// USER ACCOUNTS & DIGITAL WARDROBE
// ============================================================

model User {
  id       String @id @default(cuid())
  email    String @unique
  password String // hashed
  name     String @default("")

  wardrobe     DigitalWardrobe[]
  savedOutfits SavedOutfit[]
  ownGarments  Garment[]         @relation("OwnedGarments")
  wearLogs     WearLog[]
  feedback     OutfitFeedback[]

  // Style Advisor profile (hairColor, eyeColor, skinTone, underTone,
  // torsoLength, bodyProportion), so personalization follows the account.
  styleProfile Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model DigitalWardrobe {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  garment   Garment @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  garmentId String
  quantity  Int     @default(1)

  addedAt DateTime @default(now())

  @@unique([userId, garmentId])
  @@index([garmentId])
  @@map("digital_wardrobe")
}

model SavedOutfit {
  id          String            @id @default(cuid())
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  name        String            @default("My Saved Outfit")
  outfitScore Int               @default(80)
  items       SavedOutfitItem[]

  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@map("saved_outfits")
}

model SavedOutfitItem {
  id         String      @id @default(cuid())
  outfit     SavedOutfit @relation(fields: [outfitId], references: [id], onDelete: Cascade)
  outfitId   String
  garment    Garment     @relation(fields: [garmentId], references: [id], onDelete: Cascade)
  garmentId  String
  layerOrder Int         @default(1)

  @@unique([outfitId, garmentId])
  @@index([garmentId])
  @@map("saved_outfit_items")
}

// ============================================================
// WEAR HISTORY & FEEDBACK
// ============================================================

// "I wore this today" — powers the outfit calendar and keeps the daily
// suggestion from repeating recently worn pieces. Garment ids are stored as
// a plain list (not a relation) so history survives a garment being deleted.
model WearLog {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  wornOn      DateTime @db.Date
  garmentIds  String[]
  outfitScore Int?

  createdAt DateTime @default(now())

  @@index([userId, wornOn])
  @@map("wear_logs")
}

// Thumbs up / down on a suggested outfit. One vote per user per outfit
// (outfitKey = sorted garment ids joined by "|"); used to re-rank that
// user's future suggestions.
model OutfitFeedback {
  id         String   @id @default(cuid())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  outfitKey  String
  garmentIds String[]
  rating     Int // 1 = like, -1 = dislike

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, outfitKey])
  @@map("outfit_feedback")
}
